idade" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;" vertex="1" parent="1"><mxGeometry x="60" y="100" width="220" height="80" as="geometry" /></mxCell><mxCell id="b2" value="Sistema cria checklist e primeira versão" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;" vertex="1" parent="1"><mxGeometry x="330" y="100" width="220" height="80" as="geometry" /></mxCell><mxCell id="b3" value="Configurar stakeholders,&#10;seções e questões" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;" vertex="1" parent="1"><mxGeometry x="600" y="100" width="220" height="80" as="geometry" /></mxCell><mxCell id="b4" value="Configurar resposta&#10;SINGLE_CHOICE ou TEXT&#10;+ comentários" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;" vertex="1" parent="1"><mxGeometry x="870" y="100" width="230" height="90" as="geometry" /></mxCell><mxCell id="b5" value="Criar avaliação&#10;RAVersion + ChecklistVersion" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1160" y="100" width="250" height="90" as="geometry" /></mxCell><mxCell id="b6" value="Adicionar participantes e associar 0..N papéis" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1160" y="300" width="250" height="90" as="geometry" /></mxCell><mxCell id="b7" value="Sistema disponibiliza questões comuns + questões dos papéis" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;" vertex="1" parent="1"><mxGeometry x="870" y="300" width="230" height="90" as="geometry" /></mxCell><mxCell id="b8" value="Participantes respondem e comentam conforme configuração" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;" vertex="1" parent="1"><mxGeome