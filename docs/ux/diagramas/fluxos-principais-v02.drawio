itetura concreta" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;" vertex="1" parent="1"><mxGeometry x="330" y="110" width="220" height="80" as="geometry" /></mxCell><mxCell id="c3" value="Sistema cria arquitetura concreta e registra OWNER" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;" vertex="1" parent="1"><mxGeometry x="600" y="110" width="230" height="80" as="geometry" /></mxCell><mxCell id="c4" value="OWNER adiciona EDITORs&#10;(opcional)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;" vertex="1" parent="1"><mxGeometry x="880" y="110" width="220" height="80" as="geometry" /></mxCell><mxCell id="c5" value="Criar versão concreta&#10;Markdown + imagens&#10;+ RAVersion base" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1150" y="110" width="240" height="100" as="geometry" /></mxCell><mxCell id="c6" value="Cadastrar elementos concretos&#10;nome + tipo + Markdown + imagens" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1150" y="320" width="240" height="100" as="geometry" /></mxCell><mxCell id="c7" value="Selecionar elemento concreto e 0..N elementos da RA base" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;" vertex="1" parent="1"><mxGeometry x="860" y="320" width="240" height="100" as="geometry" /></mxCell><mxCell id="c8" value="Sistema valida que os RAElements pertencem à RAVersion base" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;" vertex="1" parent="1"><mxGeometry x="570" y="320" width="240" height="100" as="geometry" /></mxCell><mxCell id="c9" value="Registrar ElementMapping&#10;N:N" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;" vertex=