# Copie para .env na raiz; substitua os dois valores abaixo.
DJANGO_SECRET_KEY=change-me-with-a-random-secret
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
DJANGO_SECURE_COOKIES=false
POSTGRES_DB=tcc_ra
POSTGRES_USER=tcc_ra
POSTGRES_PASSWORD=change-me-with-a-local-password
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433
